{
  "name": "template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "dev": "react-native start",
    "dev:android": "npm run android:dev",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --config jest.config.ts",
    "test:coverage": "jest --coverage --watchAll=false",
    "android:staging": "react-native run-android --mode=stagingdebug",
    "android:staging-release": "react-native run-android --mode=stagingrelease",
    "android:dev": "react-native run-android --mode=developmentdebug",
    "android:dev-release": "react-native run-android --mode=developmentrelease",
    "android:qa": "react-native run-android --mode=qadebug",
    "android:qa-release": "react-native run-android --mode=qarelease",
    "android:prod": "react-native run-android --mode=productiondebug",
    "android:prod-release": "react-native run-android --mode=productionrelease",
    "android:uat": "react-native run-android --mode=uatdebug",
    "android:uat-release": "react-native run-android --mode=uatrelease",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "version-major": "node auto-versioning.js major",
    "version-minor": "node auto-versioning.js minor",
    "version-patch": "node auto-versioning.js patch",
    "generateMVCScreen": "cross-env CURRENT_DIR=$INIT_CWD node ./scripts/generateMVCScreen.ts",
    "generateReduxSlice": "cross-env CURRENT_DIR=$INIT_CWD node ./scripts/generateReduxSlice.ts",
    "generateRNComponent": "cross-env CURRENT_DIR=$INIT_CWD node ./scripts/generateRNComponent.ts",
    "ios:run:template:debug": "npx react-native run-ios --scheme template --mode Debug",
    "ios:run:template:release": "npx react-native run-ios --scheme template --mode Release",
    "ios:archive:template:release": "xcodebuild -workspace ios/template.xcworkspace -scheme template -configuration Release -sdk iphoneos archive -archivePath ios/build/template.xcarchive",
    "ios:run:templateQA:debug": "npx react-native run-ios --scheme templateQA --mode Debug",
    "ios:run:templateQA:release": "npx react-native run-ios --scheme templateQA --mode Release",
    "ios:archive:templateQA:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateQA -configuration Release -sdk iphoneos archive -archivePath ios/build/templateQA.xcarchive",
    "ios:run:templateStaging:debug": "npx react-native run-ios --scheme templateStaging --mode Debug",
    "ios:run:templateStaging:release": "npx react-native run-ios --scheme templateStaging --mode Release",
    "ios:archive:templateStaging:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateStaging -configuration Release -sdk iphoneos archive -archivePath ios/build/templateStaging.xcarchive",
    "ios:run:templateUAT:debug": "npx react-native run-ios --scheme templateUAT --mode Debug",
    "ios:run:templateUAT:release": "npx react-native run-ios --scheme templateUAT --mode Release",
    "ios:archive:templateUAT:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateUAT -configuration Release -sdk iphoneos archive -archivePath ios/build/templateUAT.xcarchive",
    "ios:run:templateDevelopment:debug": "npx react-native run-ios --scheme templateDevelopment --mode Debug",
    "ios:run:templateDevelopment:release": "npx react-native run-ios --scheme templateDevelopment --mode Release",
    "ios:archive:templateDevelopment:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateDevelopment -configuration Release -sdk iphoneos archive -archivePath ios/build/templateDevelopment.xcarchive",
    "test:ci": "jest --config jest.config.ts --coverage --json --outputFile=jest-results.json --coverageThreshold='{}' --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@reduxjs/toolkit": "^2.11.2",
    "@sbaiahmed1/react-native-biometrics": "^0.14.0",
    "@sentry/react-native": "^8.6.0",
    "@shopify/flash-list": "^2.3.1",
    "axios": "^1.14.0",
    "i18next": "^26.0.2",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^17.0.1",
    "react-native": "0.84.1",
    "react-native-bootsplash": "^7.2.0",
    "react-native-config": "^1.6.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "uuid": "^13.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-testing-library": "^7.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^15.2.11",
    "plist": "^3.1.0",
    "prettier": "^3.3.3",
    "react-native-svg-transformer": "^1.3.0",
    "react-test-renderer": "19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "lodash": "^4.18.1"
  },
  "resolutions": {
    "lodash": "^4.18.1"
  }
}
